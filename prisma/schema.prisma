generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  uid          String        @id @default(uuid())
  name         String
  email        String        @unique
  authProvider String        @default("firebase")
  isPremium    Boolean       @default(false) // Преміум-статус
  referralCode String?       @unique         // Реферальний код
  fcmToken     String?       // Firebase Cloud Messaging токен
  appointments Appointment[]
  vehicles     Vehicle[]
}

// Vehicle model
model Vehicle {
  licensePlate String   @id @db.VarChar(10) // Використання licensePlate як первинного ключа
  userId       String   // UID користувача
  model        String   @db.VarChar(100)
  vehicleType  VehicleType
  tireSize     String   @db.VarChar(10)    // Розмір шин
  wheelCount   Int                       // Кількість коліс
  flatRun      Boolean                   // Підтримка Flat Run
  lowProfile   Boolean                   // Чи низький профіль шин

  user         User     @relation(fields: [userId], references: [uid])
}

// Service model
model Service {
  id             Int          @id @default(autoincrement())
  name           String       @db.VarChar(100)  // Назва послуги (наприклад, "Шиномонтаж")
  description    String       @db.VarChar(255) // Опис послуги
  perTire        Float?       // ціна за одне колесо --> ми планували давати на фронт обчислену ціну за 4 колеса
  flatRunCost    Float?       // Додаткова ціна за Flat Run
  lowProfileCost Float?       // Додаткова ціна за Low Profile
  vehicleType    VehicleType? // Тип транспортного засобу (опціонально, якщо послуга специфічна для типу авто)
  premiumDiscount Float?      // Знижка для преміум користувачів
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Referral model
model Referral {
  id             Int       @id @default(autoincrement())
  referrerId     String    // UID користувача, який запросив
  referredUserId String    // UID запрошеного користувача
  rewardClaimed  Boolean   @default(false) // Чи було отримано бонус
  createdAt      DateTime  @default(now())
}

// Completed Wheel Counter model
model CompletedWheelCounter {
  id           Int       @id @default(autoincrement())
  totalWheels  Int       // Загальна кількість виконаних коліс
  updatedAt    DateTime  @updatedAt // Дата останнього оновлення лічильника
}

// Appointment model
model Appointment {
  id               Int              @id @default(autoincrement())
  userId           String           // UID користувача
  licensePlate     String           // Використання licensePlate замість vehicleId
  dateTime         DateTime
  slotCount        Int              // Скільки 15-хвилинних слотів займає запис
  type             ServiceType
  status           AppointmentStatus @default(PENDING)
  notes            String?           @db.VarChar(255)
  cancelledByAdmin Boolean?          // Позначає, чи скасовано адміністратором
  user             User              @relation(fields: [userId], references: [uid])

  @@unique([userId, licensePlate, dateTime])
}

// Enums
enum VehicleType {
  SMALL_CAR
  MEDIUM_CAR
  TRUCK
  ONE_SLOT
  TWO_SLOTS
}

enum ServiceType {
  TIRE_ROTATION
  REPAIR_TIRE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
