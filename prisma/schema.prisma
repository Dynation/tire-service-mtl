generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  uid          String        @id @default(uuid())
  name         String
  email        String        @unique
  authProvider String        @default("firebase")
  appointments Appointment[]
  vehicles     Vehicle[]
}

// Vehicle model
model Vehicle {
  licensePlate String   @id @db.VarChar(10) // Використання licensePlate як первинного ключа
  userId       String   // UID користувача
  model        String   @db.VarChar(100)
  vehicleType  VehicleType
  tireSize     String   @db.VarChar(10)    // Розмір шин
  wheelCount   Int                       // Кількість коліс
  flatRun      Boolean                   // Підтримка Flat Run
  lowProfile   Boolean                   // Чи низький профіль шин

  user         User     @relation(fields: [userId], references: [uid])
  appointments Appointment[]
}

model Service {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(100)  // Назва послуги (наприклад, "Шиномонтаж")
  description String       @db.VarChar(255) // Опис послуги
  perTire     Float?       //  ціна за одне колесо --> ми планували давати на фронт обчислену ціну за 4 колеса, виходячи з цього поля ціни за одне колесо
  flatRunCost Float?       // Додаткова ціна за Flat Run
  lowProfileCost Float?    // Додаткова ціна за Low Profile
  vehicleType VehicleType? // Тип транспортного засобу (опціонально, якщо послуга специфічна для типу авто)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model CompletedWheelCounter {
  id           Int       @id @default(autoincrement())
  totalWheels  Int       // Загальна кількість виконаних коліс
  updatedAt    DateTime  @updatedAt // Дата останнього оновлення лічильника
}

model Appointment {
  id               Int              @id @default(autoincrement())
  userId           String           // UID користувача
  licensePlate     String           // Використання licensePlate замість vehicleId
  dateTime         DateTime
  type             ServiceType
  status           AppointmentStatus @default(PENDING)
  notes            String?           @db.VarChar(255)
  cancelledByAdmin Boolean?          // Позначає, чи скасовано адміністратором

  user             User              @relation(fields: [userId], references: [uid])
  vehicle          Vehicle           @relation(fields: [licensePlate], references: [licensePlate])

  @@unique([userId, licensePlate, dateTime])
}


// Enums
enum VehicleType {
  SMALL_CAR
  SUV
  TRUCK
}

enum ServiceType {
  TIRE
  REPAIR
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
