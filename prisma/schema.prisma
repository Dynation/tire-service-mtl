// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  uid          String        @id @default(uuid())
  name         String
  email        String        @unique
  authProvider String        @default("firebase")
  appointments Appointment[]
  vehicles     Vehicle[]
}

// Vehicle model
model Vehicle {
  licensePlate String   @id @db.VarChar(10) // Використання licensePlate як первинного ключа
  userId       String   // UID користувача
  model        String   @db.VarChar(100)
  vehicleType  VehicleType
  user         User     @relation(fields: [userId], references: [uid])
  appointments Appointment[]
}

// Appointment model
model Appointment {
  id           Int              @id @default(autoincrement())
  userId       String           // UID користувача
  licensePlate String           // Використання licensePlate замість vehicleId
  dateTime     DateTime
  type         ServiceType
  status       AppointmentStatus @default(PENDING)
  notes        String?           @db.VarChar(255)
  tireSize     String
  wheelCount   Int
  flatRun      Boolean
  lowProfile   Boolean

  user         User              @relation(fields: [userId], references: [uid])
  vehicle      Vehicle           @relation(fields: [licensePlate], references: [licensePlate])

  @@unique([userId, licensePlate, dateTime])
}

model Service {
  id        Int     @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// Enums
enum VehicleType {
  SMALL_CAR
  SUV
  TRUCK
}

enum ServiceType {
  TIRE
  REPAIR
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
